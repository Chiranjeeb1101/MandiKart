# ==============================================================================
# MANDIKART — UNIFIED GLOBAL ROOT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env in the monorepo root:
#   cp .env.example .env
#
# This single file defines every configuration variable across all backends,
# microservices, web dashboards, and mobile applications.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLATFORM ENVIRONMENT & DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. MICROSERVICE PORTS & NETWORKING
# ------------------------------------------------------------------------------
PORT=4000
FARMER_BACKEND_PORT=4000
USER_BACKEND_PORT=4001
LOGISTIC_BACKEND_PORT=4002
ADMIN_BACKEND_PORT=4003

# ------------------------------------------------------------------------------
# 3. SUPABASE SECRETS & LEDGER (Shared Database, Auth & Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-for-development
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_PRODUCTS=products
SUPABASE_STORAGE_BUCKET_LAND=land_records
SUPABASE_STORAGE_BUCKET_POD=pod

# ------------------------------------------------------------------------------
# 4. SECURITY, CRYPTOGRAPHY & SESSIONS
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_mandikart_jwt_development_key_32bytes_long
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_EXPIRY_HOURS=720

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT GATEWAY & ESCROW CONFIGURATION
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_mandikart_demo_secret_key_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_mandikart_demo_publishable_key_placeholder
STRIPE_WEBHOOK_SECRET=whsec_mandikart_demo_webhook_placeholder
STRIPE_CURRENCY=inr

# ------------------------------------------------------------------------------
# 6. FIREBASE FREE-TIER SUITE CONFIGURATION
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=mandikart-demo
FIREBASE_API_KEY=AIzaSyDemoPlaceholderKeyForMandiKartPlatform
FIREBASE_AUTH_DOMAIN=mandikart-demo.firebaseapp.com
FIREBASE_DATABASE_URL=https://mandikart-demo-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=mandikart-demo.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=102938475610
FIREBASE_APP_ID=1:102938475610:web:abcdef1234567890
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# ------------------------------------------------------------------------------
# 7. HYPER-LOCAL WEATHER & AGRI-ADVISORY API
# ------------------------------------------------------------------------------
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_MINUTES=30

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT BASE URLS & CLIENT-SAFE KEYS (EXPO / MOBILE / WEB)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_USER_API_URL=http://localhost:4001/api/v1
EXPO_PUBLIC_FARMER_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_LOGISTIC_API_URL=http://localhost:4002/api/v1
EXPO_PUBLIC_ADMIN_API_URL=http://localhost:4003/api/v1

# Supabase Client-Safe Keys for Expo Frontends
EXPO_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Stripe Client-Safe Publishable Key for Mobile/Web Checkout
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mandikart_demo_publishable_key_placeholder

# Firebase Client-Safe Configuration for Frontend SDKs
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDemoPlaceholderKeyForMandiKartPlatform
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mandikart-demo.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mandikart-demo
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=mandikart-demo.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=102938475610
EXPO_PUBLIC_FIREBASE_APP_ID=1:102938475610:web:abcdef1234567890

