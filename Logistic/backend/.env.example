# MandiKart Logistic Backend — Environment Variables
# Copy this file to .env and fill in your values.
# In MOCK mode (no Supabase), only PORT is required.

# ─── Server ──────────────────────────────────────────────────────────────────
LOGISTIC_BACKEND_PORT=4002
CORS_ORIGIN=*

# ─── Supabase (leave as-is to run in MOCK mode) ───────────────────────────────
# Set these to enable real database connectivity.
SUPABASE_URL=placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Webhooks (other microservice URLs) ───────────────────────────────────────
FARMER_WEBHOOK_URL=http://localhost:4000/api/webhooks/logistics
USER_WEBHOOK_URL=http://localhost:4001/api/webhooks/logistics

# ─── Auth (Production only) ────────────────────────────────────────────────────
# JWT_SECRET=your-super-secret-jwt-key

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
